# CampusConnect Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=campusconnect_secure_jwt_secret_key_2025

# Optional: PostgreSQL Database URL (e.g. Supabase, Neon, Render Postgres)
# If not provided, CampusConnect automatically uses pure WebAssembly SQLite persistence with identical schema!
# DATABASE_URL=postgresql://postgres:password@localhost:5432/campusconnect
